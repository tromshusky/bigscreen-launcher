{
  "app-id": "com.github.tromshusky.bigscreenLauncher",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.gnome.Sdk.Locale"
  ],
  "command": "bigscreen-launcher",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--system-talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--filesystem=host"
  ],
  "modules": [
    {
      "name": "bigscreen-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin /app/share/applications",
        "mkdir -p /app/lib/python3.11/site-packages",
        "cp -r src/* /app/lib/python3.11/site-packages/",
        "mkdir -p /app/share/icons/hicolor/scalable/apps",
        "cp data/icons/com.github.tromshusky.bigscreenLauncher.svg /app/share/icons/hicolor/scalable/apps/ || true",
        "mkdir -p /app/share/applications",
        "cp data/com.github.tromshusky.bigscreenLauncher.desktop /app/share/applications/ || true",
        "install -Dm755 /dev/stdin /app/bin/bigscreen-launcher << 'EOF'\n#!/usr/bin/env python3\nimport sys\nfrom main import main\nif __name__ == '__main__':\n    sys.exit(main())\nEOF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
